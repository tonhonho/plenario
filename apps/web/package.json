{
  "name": "@plenario/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:estatico": "VITE_DADOS=estatico vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && VITE_DADOS=estatico VITE_BASE=/plenario/ vite build",
    "preview": "vite preview",
    "preview:pages": "VITE_BASE=/plenario/ vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@plenario/core": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0"
  }
}
